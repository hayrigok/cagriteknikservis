---
/*
  Para sayfası. Tek generic rota: hizmetler × geçerli ilçeler.

  yerelNotlar kapısından geçemeyen ilçeler getStaticPaths'e HİÇ GİRMEZ,
  dolayısıyla o kombinasyonlar için HTML üretilmez ve build uyarı basar.
  Bu kapıyı gevşetmeyin: içi boş şablon ilçe sayfaları Google tarafından
  doorway page sayılır ve ceza tek sayfaya değil tüm siteye işler.
*/
import BaseLayout from '@/layouts/BaseLayout.astro';
import StickyUstCubuk from '@/components/StickyUstCubuk.astro';
import Hero from '@/components/Hero.astro';
import GuvenRozetleri from '@/components/GuvenRozetleri.astro';
import OlcuSeridi from '@/components/OlcuSeridi.astro';
import FiyatTablosu from '@/components/FiyatTablosu.astro';
import ArizaCozum from '@/components/ArizaCozum.astro';
import Markalar from '@/components/Markalar.astro';
import Surec from '@/components/Surec.astro';
import IlceBlogu from '@/components/IlceBlogu.astro';
import Yorumlar from '@/components/Yorumlar.astro';
import Sss from '@/components/Sss.astro';
import IletisimFormu from '@/components/IletisimFormu.astro';
import KomsuIlceler from '@/components/KomsuIlceler.astro';
import AltCta from '@/components/AltCta.astro';
import Footer from '@/components/Footer.astro';
import MobilBar from '@/components/MobilBar.astro';
import YanButonlar from '@/components/YanButonlar.astro';

import type { Hizmet, Ilce } from '@/lib/types';
import { aktifHizmetler, gecerliIlceler, h1Uret, hizmetIkonu } from '@/lib/veri';
import { paraSayfasiDescription, paraSayfasiTitle } from '@/lib/seo';
import { breadcrumb, faqPage, serviceSchema } from '@/lib/schema';

export function getStaticPaths() {
  const hizmetler = aktifHizmetler();
  const ilceler = gecerliIlceler();

  return hizmetler.flatMap((hizmet) =>
    ilceler.map((ilce) => ({
      params: { hizmet: hizmet.slug, ilce: ilce.slug },
      props: { hizmet, ilce },
    }))
  );
}

interface Props {
  hizmet: Hizmet;
  ilce: Ilce;
}

const { hizmet, ilce } = Astro.props;

const yol = `/${hizmet.slug}/${ilce.slug}/`;
const h1 = h1Uret(hizmet, ilce);
const cihaz = hizmet.cihaz.toLocaleLowerCase('tr-TR');
// Montajın arızası yok; sabit metinlerin dili buradan seçiliyor (bkz. HizmetTuru).
const montaj = hizmet.tur === 'montaj';
const waMesaji = `Merhaba, ${ilce.ad} için ${hizmet.ad.toLocaleLowerCase('tr-TR')} hakkında bilgi almak istiyorum.`;

const schema = [
  serviceSchema(Astro.site!, hizmet, ilce, yol),
  faqPage(hizmet.sss),
  breadcrumb(Astro.site!, [
    { ad: 'Ana sayfa', yol: '/' },
    { ad: hizmet.ad, yol: `/${hizmet.slug}/` },
    { ad: ilce.ad, yol },
  ]),
];
---

<BaseLayout
  title={paraSayfasiTitle(hizmet, ilce)}
  description={paraSayfasiDescription(hizmet, ilce)}
  yol={yol}
  schema={schema}
  sayfaKimligi={`${hizmet.slug}/${ilce.slug}`}
>
  <StickyUstCubuk />

  <main id="icerik">
  <Hero
    h1={h1}
    altBaslik={hizmet.altBaslik}
    etiket={`${ilce.sehir} · ${ilce.ad}`}
    ikon={hizmetIkonu(hizmet.slug)}
    waMesaji={waMesaji}
  />
  <GuvenRozetleri tur={hizmet.tur} />
  <OlcuSeridi />

  <FiyatTablosu
    satirlar={hizmet.fiyatAraligi}
    baslik={`${ilce.ad} ${hizmet.ad} fiyatları`}
    baslikBos={montaj
      ? `${ilce.ad} için ${hizmet.ad.toLocaleLowerCase('tr-TR')} kapsamında yaptığımız işlemler`
      : `${ilce.ad} için ${cihaz} servisinde yaptığımız işlemler`}
    aciklamaBos={montaj
      ? 'Tutar, klimanın yerine ve boru mesafesine göre değişiyor. Yaptığımız işlemler aşağıda; fiyatı yerinde keşiften sonra, işleme başlamadan önce söyleriz.'
      : undefined}
  />
  <ArizaCozum
    arizalar={hizmet.ariza}
    baslik={hizmet.arizaBaslik ?? `En sık çıkan ${cihaz} arızaları`}
    etiket={montaj ? 'Sık sorulanlar' : undefined}
  />
  <Markalar cihaz={cihaz} />
  <Surec tur={hizmet.tur} />
  <IlceBlogu ilce={ilce} hizmetAdi={hizmet.ad} />
  <Yorumlar />
  <Sss sorular={hizmet.sss} />
  <IletisimFormu baglam={`${h1} talebi`} />
  <KomsuIlceler hizmet={hizmet} ilce={ilce} />
  <AltCta baslik={`${ilce.ad} için hemen randevu alın`} waMesaji={waMesaji} />
  </main>

  <Footer />
  <MobilBar waMesaji={waMesaji} />
  <YanButonlar waMesaji={waMesaji} />
</BaseLayout>
