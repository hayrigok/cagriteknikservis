---
/*
  12 — Form. SADECE 3 alan + KVKK onayı. Az alan = yüksek dönüşüm.

  Gönderim: backend yok. Alanlar WhatsApp mesajına yazılıp wa.me'ye yönlendirilir.
  form_submit olayı yönlendirmeden HEMEN ÖNCE tetiklenir; yani "WhatsApp açıldı"
  demektir, "mesaj ulaştı" demez. Dönüşüm kurulumunda bu ayrımı akılda tutun.
*/
import Bolum from './Bolum.astro';
import Ikon from './Ikon.astro';
import { firma, deger } from '@/lib/veri';

interface Props {
  baglam: string;
  zemin?: 'beyaz' | 'zemin';
}

const { baglam, zemin = 'beyaz' } = Astro.props;
const numara = deger(firma.whatsapp)?.replace(/\D/g, '') ?? '';
const telefon = deger(firma.telefon);

// 16 px altına inilmiyor: iOS Safari daha küçük yazıda alana odaklanınca
// sayfayı yakınlaştırır ve kullanıcı yakınlaşmış bir formda kalır.
const alan =
  'mt-2 w-full rounded-sm border-2 border-lacivert-100 bg-white px-4 py-3 text-govde ' +
  'text-metin outline-none transition-colors duration-150 placeholder:text-metin-soluk/70 ' +
  'focus:border-lacivert-600 aria-[invalid=true]:border-turuncu-600';
---

<Bolum
  etiket="Form"
  baslik="Sizi arayalım"
  aciklama="Üç bilgi yeterli. Gönderdiğinizde WhatsApp'ı hazır mesajla açıyoruz, siz bir şey yazmıyorsunuz."
  zemin={zemin}
>
  <form
    data-form
    data-numara={numara}
    data-baglam={baglam}
    class="grid max-w-2xl gap-5 rounded-md border border-lacivert-100 bg-white p-6 lg:p-8"
    novalidate
  >
    <div>
      <label for="f-ad" class="block font-semibold text-lacivert-900">Adınız</label>
      <input id="f-ad" name="ad" type="text" required autocomplete="name" class={alan} />
    </div>

    <div>
      <label for="f-tel" class="block font-semibold text-lacivert-900">Telefonunuz</label>
      <input
        id="f-tel"
        name="telefon"
        type="tel"
        required
        inputmode="tel"
        autocomplete="tel"
        placeholder="05XX XXX XX XX"
        class={`${alan} rakam`}
      />
    </div>

    <div>
      <label for="f-ariza" class="block font-semibold text-lacivert-900">Arıza</label>
      <textarea id="f-ariza" name="ariza" required rows="3" class={alan}></textarea>
      <p class="mt-2 text-kucuk text-metin-soluk">
        Cihazın markasını ve şikâyeti yazarsanız uygun parçayla geliriz.
      </p>
    </div>

    <label class="flex cursor-pointer items-start gap-3 text-kucuk leading-relaxed text-metin-soluk">
      <input
        id="f-kvkk"
        name="kvkk"
        type="checkbox"
        required
        class="mt-0.5 h-5 w-5 shrink-0 accent-lacivert-600"
      />
      <span>
        <a href="/kvkk/" class="font-semibold text-lacivert-700 underline">KVKK aydınlatma metnini</a>
        okudum; bilgilerimin bana dönüş yapılması amacıyla işlenmesini onaylıyorum.
      </span>
    </label>

    <p
      data-hata
      class="hidden items-start gap-2 rounded-sm border-l-4 border-turuncu-600 bg-zemin px-4 py-3 text-kucuk font-semibold text-turuncu-700"
      role="alert"
    >
    </p>

    <button
      type="submit"
      class="inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-sm bg-yesil-600 px-6 text-lead font-bold text-white transition-colors duration-150 hover:bg-yesil-700 disabled:cursor-not-allowed disabled:opacity-55 sm:w-auto sm:justify-self-start"
      disabled={!numara}
    >
      <Ikon ad="whatsapp" boyut={20} />
      WhatsApp'tan Gönder
    </button>

    {/* WhatsApp numarası yoksa gönderim yapılamaz. İskele metni yerine
        ziyaretçiye işine yarayan tek şeyi söyleriz: nereden ulaşacağını. */}
    {
      !numara && (
        <p class="text-kucuk leading-relaxed text-metin-soluk">
          {telefon
            ? `Form şu an kapalı. Bize ${telefon} numarasından ulaşabilirsiniz.`
            : 'Form şu an kapalı.'}
        </p>
      )
    }
  </form>
</Bolum>

<script>
  import { izle } from '@/lib/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const hata = form?.querySelector<HTMLElement>('[data-hata]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !hata) return;

    const veri = new FormData(form);
    const ad = String(veri.get('ad') ?? '').trim();
    const telefon = String(veri.get('telefon') ?? '').trim();
    const ariza = String(veri.get('ariza') ?? '').trim();
    const kvkk = veri.get('kvkk') === 'on';

    // Hata hangi alanı kastediyorsa odağı oraya taşırız: kullanıcı "neyi
    // düzelteceğim" diye formu taramak zorunda kalmasın.
    let mesaj = '';
    let kusurlu = '';
    if (!ad) [mesaj, kusurlu] = ['Adınızı yazın.', 'f-ad'];
    else if (!telefon) [mesaj, kusurlu] = ['Telefon numaranızı yazın.', 'f-tel'];
    else if (telefon.replace(/\D/g, '').length < 10)
      [mesaj, kusurlu] = ['Telefon numarası eksik görünüyor.', 'f-tel'];
    else if (!ariza) [mesaj, kusurlu] = ['Arızayı kısaca anlatın.', 'f-ariza'];
    else if (!kvkk) [mesaj, kusurlu] = ['Devam etmek için KVKK onayı gerekiyor.', 'f-kvkk'];

    for (const el of form.querySelectorAll('[aria-invalid]')) el.removeAttribute('aria-invalid');

    if (mesaj) {
      hata.textContent = mesaj;
      hata.classList.remove('hidden');
      hata.classList.add('flex');
      const hedef = form.querySelector<HTMLElement>(`#${kusurlu}`);
      hedef?.setAttribute('aria-invalid', 'true');
      hedef?.focus();
      return;
    }
    hata.classList.add('hidden');
    hata.classList.remove('flex');

    const numara = form.dataset.numara ?? '';
    const baglam = form.dataset.baglam ?? '';
    const sayfa = document.documentElement.dataset.sayfa ?? 'bilinmiyor';

    const metin = `${baglam}\n\nAd: ${ad}\nTelefon: ${telefon}\nArıza: ${ariza}`;
    const adres = `https://wa.me/${numara}?text=${encodeURIComponent(metin)}`;

    // Yönlendirmeden ÖNCE tetikle: sayfa terk edilince olay gönderilemez.
    izle({ ad: 'form_submit', sayfa });

    /*
      wa.me'ye DOĞRUDAN gitmiyoruz, önce /tesekkurler/ sayfasına uğruyoruz.
      İki sebep, ikisi de o sayfanın başındaki yorumda uzun uzun yazılı:
      dönüşümün karşılığı olan bir adres doğuyor (Ads bunu istiyor) ve WhatsApp
      açılmazsa ziyaretçi boşlukta kalmıyor.

      Mesaj sorgu dizesiyle değil sessionStorage ile taşınıyor: ad, telefon ve
      arıza açıklaması adres çubuğuna, erişim kayıtlarına ve ölçüm raporlarına
      girmesin. Bayrak "bu ziyaret formdan geldi" demek — teşekkür sayfası
      WhatsApp'ı yalnızca o zaman kendiliğinden açar.

      sessionStorage kapalıysa (bazı gizli mod / kısıtlı tarayıcı ayarları)
      eski davranışa düşüyoruz: doğrudan wa.me. Ölçüm kaybolur, mesaj gider —
      bu sıralama bilinçli, mesaj ölçümden önce gelir.
    */
    try {
      sessionStorage.setItem('cs_wa', adres);
      sessionStorage.setItem('cs_wa_oto', '1');
      window.location.href = '/tesekkurler/';
    } catch {
      window.location.href = adres;
    }
  });
</script>
