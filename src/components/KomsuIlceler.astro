---
/*
  İç link bloğu — yetim sayfa bırakmamak için. Her para sayfası hizmet hub'ına,
  komşu ilçelere ve aynı ilçedeki diğer hizmetlere link verir.
  komsuIlceler() listeyi döngüsel gezer: tek yönlü link yığılması olmaz.
*/
import Bolum from './Bolum.astro';
import Ikon from './Ikon.astro';
import type { Hizmet, Ilce } from '@/lib/types';
import { aktifHizmetler, hizmetIkonu, komsuIlceler } from '@/lib/veri';

interface Props {
  hizmet: Hizmet;
  ilce: Ilce;
}

const { hizmet, ilce } = Astro.props;

const komsular = komsuIlceler(ilce.slug);
const digerHizmetler = aktifHizmetler().filter((h) => h.slug !== hizmet.slug);

const satir =
  'flex min-h-12 items-center justify-between gap-4 rounded-sm px-4 py-2.5 font-medium text-kobalt-600 transition-colors duration-150 hover:bg-lacivert-50 hover:text-lacivert-900';
---

<Bolum etiket="Yakın sayfalar" baslik="Başka nereye bakabilirsiniz?" zemin="beyaz">
  <div class="grid gap-10 lg:grid-cols-2">
    {
      komsular.length > 0 && (
        <nav aria-label="Yakın bölgeler">
          <h3 class="etiket text-metin-soluk">
            Yakın bölgelerde {hizmet.ad.toLocaleLowerCase('tr-TR')}
          </h3>
          <ul class="mt-4 grid gap-1">
            {komsular.map((k) => (
              <li>
                <a href={`/${hizmet.slug}/${k.slug}/`} class={satir}>
                  <span class="flex items-center gap-3">
                    <Ikon ad="konum" boyut={18} class="shrink-0 text-kobalt-600" />
                    {k.ad} {hizmet.ad}
                  </span>
                  <Ikon ad="ok" boyut={18} class="shrink-0 text-kobalt-600" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      digerHizmetler.length > 0 && (
        <nav aria-label="Diğer hizmetler">
          <h3 class="etiket text-metin-soluk">{ilce.ad}'de diğer hizmetlerimiz</h3>
          <ul class="mt-4 grid gap-1">
            {digerHizmetler.slice(0, 6).map((h) => (
              <li>
                <a href={`/${h.slug}/${ilce.slug}/`} class={satir}>
                  <span class="flex items-center gap-3">
                    <Ikon ad={hizmetIkonu(h.slug)} boyut={18} class="shrink-0 text-kobalt-600" />
                    {ilce.ad} {h.ad}
                  </span>
                  <Ikon ad="ok" boyut={18} class="shrink-0 text-kobalt-600" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Bolum>
