---
// 5 — Üç güven rozeti. İkonlar dolu renk kaplarında (DB: "icons inside solid
// colored containers") — kutu, kartın görsel ağırlığını taşıyan şey.
import Ikon from './Ikon.astro';
import { firma, deger } from '@/lib/veri';
import type { IkonAdi, HizmetTuru } from '@/lib/types';

// Montaj sayfasında "arıza" yok: orada yerinde bakılan şey yer, mesafe ve
// tesisat. Rozetin vaadi aynı (önce görürüz, sonra tutarı söyleriz), yalnızca
// işin adı değişiyor — uydurma bir vaat eklemiyoruz.
interface Props {
  tur?: HizmetTuru;
}

const { tur = 'tamir' } = Astro.props;
const montaj = tur === 'montaj';

// Sabit garanti süresi YOK: sahibi "parçaya göre değişiyor" dedi. Rozete
// uydurma süre yazmak yerine mekanizmayı anlatıyoruz. İfade hiç yoksa rozet
// basılmaz ve şerit ikiye düşer — garanti hakkında boş konuşmayız.
const garanti = deger(firma.garantiIfadesi);

type Rozet = { ikon: IkonAdi; baslik: string; aciklama: string };

const rozetler: Rozet[] = [
  garanti
    ? {
        ikon: 'kalkan' as IkonAdi,
        baslik: garanti,
        aciklama: 'Takılan parçanın garantisi geçerli. Süresini takmadan önce söyleriz.',
      }
    : null,
  {
    ikon: 'arama',
    baslik: montaj ? 'Montajda keşif ücretsiz' : 'Onarımda tespit ücretsiz',
    aciklama: montaj
      ? 'Yeri ve mesafeyi yerinde görür, fiyatı önce söyleriz. Montajı yaptırırsanız keşif için ayrıca ücret almayız.'
      : 'Arızayı yerinde belirler, fiyatı önce söyleriz. Onarımı yaptırırsanız tespit için ayrıca ücret almayız.',
  },
  {
    ikon: 'kart',
    baslik: 'Kapıda ödeme',
    aciklama: 'Nakit veya kart. İşlem bitmeden ödeme istemeyiz.',
  },
].filter((r): r is Rozet => r !== null);

const sutun = rozetler.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<section class="bg-white">
  <ul class:list={['kap grid gap-5 py-10 sm:py-12 lg:gap-8', sutun]}>
    {
      rozetler.map((r) => (
        <li class="flex gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-sm bg-kobalt-50 text-kobalt-600">
            <Ikon ad={r.ikon} boyut={24} />
          </span>
          <div class="min-w-0">
            <p class="leading-snug font-bold text-lacivert-900">{r.baslik}</p>
            <p class="mt-1 text-kucuk leading-relaxed text-metin-soluk">{r.aciklama}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
