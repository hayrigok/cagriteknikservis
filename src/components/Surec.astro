---
// 8 — Süreç, 4 adım. Koyu blok: sayfanın ortasında ikinci bir renk alanı,
// aksi hâlde beyaz/gri sıralaması tekdüze kalıyor.
import Bolum from './Bolum.astro';
import type { HizmetTuru } from '@/lib/types';

// Dört adımın SIRASI ve mantığı her hizmette aynı: ara → randevu → yerinde gör
// → onay al, sonra başla. Değişen tek şey üçüncü adımda bakılan şeyin adı.
// Montajda arıza yoktur; yer, mesafe ve tesisat vardır.
interface Props {
  tur?: HizmetTuru;
}

const { tur = 'tamir' } = Astro.props;
const montaj = tur === 'montaj';

const adimlar = montaj
  ? [
      {
        baslik: 'Arayın',
        metin: 'Klimanın modelini ve nereye takılacağını söylersiniz, uygun malzemeyle yola çıkarız.',
      },
      {
        baslik: 'Randevu',
        metin: 'Size uyan saati birlikte belirleriz. Montaj tamirden uzun sürer, saati ona göre ayarlarız.',
      },
      {
        baslik: 'Yerinde keşif',
        metin: 'Yeri, boru mesafesini ve tahliye güzergâhını görür, ne yapılacağını ve tutarı söyleriz.',
      },
      {
        baslik: 'Onay ve montaj',
        metin:
          'Siz onaylayınca başlarız. Bitince klimayı birlikte çalıştırır, su tahliyesini ve soğutmayı test ederiz.',
      },
    ]
  : [
      {
        baslik: 'Arayın',
        metin: 'Cihazın markasını ve şikâyeti söylersiniz, uygun parçayla yola çıkarız.',
      },
      {
        baslik: 'Randevu',
        metin: 'Size uyan saati birlikte belirleriz. Aynı gün gitmeye çalışırız.',
      },
      {
        baslik: 'Yerinde tespit',
        metin: 'Arızayı görür, ne yapılacağını ve tutarı söyleriz.',
      },
      {
        baslik: 'Onay ve onarım',
        metin:
          'Siz onaylayınca başlarız. Bitince cihazı birlikte test eder, garanti süresini size söyleriz.',
      },
    ];
---

<Bolum
  etiket="Süreç"
  baslik="Nasıl çalışıyoruz?"
  aciklama="Dört adım. Hiçbirinde sürpriz yok — tutarı duymadan işlem başlamaz."
  zemin="lacivert"
>
  {/* Numara süs değil: adımlar gerçekten sırayla oluyor. */}
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      adimlar.map((a, i) => (
        <li class="rounded-lg border border-white/10 bg-white/[0.05] p-6">
          <span
            class="rakam flex h-11 w-11 items-center justify-center rounded-full bg-turuncu-500 text-lead font-extrabold text-lacivert-900"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-h3 mt-4 font-bold text-white">{a.baslik}</h3>
          <p class="mt-2 leading-relaxed text-lacivert-200">{a.metin}</p>
        </li>
      ))
    }
  </ol>
</Bolum>
