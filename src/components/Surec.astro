---
// 8 — Süreç, 4 adım. Koyu blok: sayfanın ortasında ikinci bir renk alanı,
// aksi hâlde beyaz/gri sıralaması tekdüze kalıyor.
import Bolum from './Bolum.astro';

const adimlar = [
  {
    baslik: 'Arayın',
    metin: 'Cihazın markasını ve şikâyeti söylersiniz, uygun parçayla yola çıkarız.',
  },
  {
    baslik: 'Randevu',
    metin: 'Size uyan saati birlikte belirleriz. Aynı gün gitmeye çalışırız.',
  },
  {
    baslik: 'Yerinde tespit',
    metin: 'Arızayı görür, ne yapılacağını ve tutarı söyleriz.',
  },
  {
    baslik: 'Onay ve onarım',
    metin:
      'Siz onaylayınca başlarız. Bitince cihazı birlikte test eder, garanti süresini size söyleriz.',
  },
];
---

<Bolum
  etiket="Süreç"
  baslik="Nasıl çalışıyoruz?"
  aciklama="Dört adım. Hiçbirinde sürpriz yok — tutarı duymadan işlem başlamaz."
  zemin="lacivert"
>
  {/* Numaralandırma süs değil: adımlar gerçekten sırayla oluyor. */}
  <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      adimlar.map((a, i) => (
        <li>
          <span
            class="rakam flex h-12 w-12 items-center justify-center rounded-sm bg-turuncu-600 text-h3 font-bold text-white"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-h3 mt-4 font-bold text-white">{a.baslik}</h3>
          <p class="mt-2 leading-relaxed text-lacivert-200">{a.metin}</p>
        </li>
      ))
    }
  </ol>
</Bolum>
