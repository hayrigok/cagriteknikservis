---
// 9 — İlçeye özgü blok. Bu bloğun içeriği (yerelNotlar) sayfanın var olma
// gerekçesi: boşsa build sayfayı zaten üretmez (bkz. lib/veri.ts ilçe kapısı).
import Bolum from './Bolum.astro';
import Ikon from './Ikon.astro';
import type { Ilce } from '@/lib/types';
import { deger, degerListesi, firma } from '@/lib/veri';

interface Props {
  ilce: Ilce;
  hizmetAdi: string;
}

const { ilce, hizmetAdi } = Astro.props;

/*
  Kapı yalnızca yerelNotlar'ı zorunlu tutuyor; ulaşım süresi ve mahalle bilgisi
  ondan bağımsız gelebilir. Gelmemişse o kutu hiç basılmaz, ikisi de yoksa sağ
  sütun düşer ve saha notu tam genişliğe yayılır.

  Mahalle kutusu İKİ KADEMELİ (12.08.2026):
    1. `ilce.mahalleler` doluysa ad ad basılır — en değerlisi budur.
    2. Boşsa `firma.mahalleKapsami` cümlesine düşer ("Bütün mahalle ve
       semtler"), çünkü sahibi ad listesi vermek istemedi (A2) ama kapsamı
       net söyledi. Liste yok diye bilgiyi hiç göstermemek, elimizdeki gerçek
       cevabı saklamak olurdu.
    3. İkisi de boşsa kutu yine hiç basılmaz — {PLACEHOLDER} sözleşmesi aynen.
*/
const mahalleler = degerListesi(ilce.mahalleler);
const mahalleKapsami = deger(firma.mahalleKapsami);
const mahalleMetni = mahalleler.length > 0 ? mahalleler.join(', ') : mahalleKapsami;
const ulasimVar = ilce.ulasimDk > 0;
const yanSutun = ulasimVar || mahalleMetni !== null;
---

<Bolum
  etiket="Bölge"
  baslik={`${ilce.ad}'de ${hizmetAdi.toLocaleLowerCase('tr-TR')}`}
  zemin="zemin"
>
  <div class:list={['grid gap-8', yanSutun && 'lg:grid-cols-[1.4fr_1fr]']}>
    {/* Sayfanın var olma gerekçesi bu paragraf. */}
    <div class="rounded-md border-l-4 border-turuncu-600 bg-white p-6 lg:p-8">
      <p class="text-lead leading-relaxed text-metin">{ilce.yerelNotlar}</p>
    </div>

    {
      yanSutun && (
        /* self-start: tek satırlık kutu, yanındaki uzun notun boyuna esnemesin */
        <dl class="grid gap-px self-start overflow-hidden rounded-md bg-lacivert-100">
          {ulasimVar && (
            <div class="bg-white p-6">
              <dt class="plaka flex items-center gap-2 text-metin-soluk">
                <Ikon ad="saat" boyut={16} class="text-turuncu-600" />
                Ortalama ulaşım
              </dt>
              <dd class="mt-2">
                <span class="rakam text-dev leading-none font-bold text-lacivert-900">
                  {ilce.ulasimDk}
                  <span class="text-h3 ml-1 font-bold text-turuncu-700">dakika</span>
                </span>
              </dd>
            </div>
          )}

          {mahalleMetni && (
            <div class="bg-white p-6">
              <dt class="plaka flex items-center gap-2 text-metin-soluk">
                <Ikon ad="konum" boyut={16} class="text-turuncu-600" />
                Gittiğimiz mahalleler
              </dt>
              <dd class="mt-2 leading-relaxed text-metin">
                {mahalleler.length > 0 ? mahalleMetni : `${ilce.ad} genelinde ${mahalleMetni.toLocaleLowerCase('tr-TR')}`}
              </dd>
            </div>
          )}
        </dl>
      )
    }
  </div>
</Bolum>
