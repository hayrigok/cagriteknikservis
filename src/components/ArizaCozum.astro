---
// 7 — Arıza → çözüm listesi. Her çözüm iki cümle.
import type { Ariza } from '@/lib/types';

interface Props {
  arizalar: Ariza[];
  baslik: string;
}

const { arizalar, baslik } = Astro.props;
---

<section class="bg-marka-50">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="text-2xl font-bold text-marka-900">{baslik}</h2>

    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        arizalar.map((a) => (
          <li class="rounded-lg border border-marka-100 bg-white p-4">
            <h3 class="font-semibold text-marka-900">{a.baslik}</h3>
            <p class="mt-1.5 text-metin-soluk">{a.cozum}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
