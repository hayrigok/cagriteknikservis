---
// 7 — Arıza → çözüm listesi. Her çözüm iki cümle: belirti + ne yaptığımız.
import Bolum from './Bolum.astro';
import Ikon from './Ikon.astro';
import type { Ariza } from '@/lib/types';

interface Props {
  arizalar: Ariza[];
  baslik: string;
  etiket?: string;
  zemin?: 'beyaz' | 'zemin';
}

const { arizalar, baslik, etiket = 'Sık gelen arızalar', zemin = 'zemin' } = Astro.props;
---

<Bolum etiket={etiket} baslik={baslik} zemin={zemin}>
  <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      arizalar.map((a) => (
        <li class="flex flex-col rounded-md border border-lacivert-100 bg-white p-6">
          <h3 class="flex items-start gap-3 leading-snug font-bold text-lacivert-900">
            <Ikon ad="arac" boyut={20} class="mt-0.5 shrink-0 text-turuncu-600" />
            {a.baslik}
          </h3>
          <p class="mt-3 leading-relaxed text-metin-soluk">{a.cozum}</p>
        </li>
      ))
    }
  </ul>
</Bolum>
