---
/*
  Satır içi SVG ikon seti. İkon paketi KURULMUYOR (onaylı paket listesi dışında)
  ve emoji kullanılmıyor. Hepsi 24×24 ızgarada, 1.7 px kontur, yuvarlak uç —
  set olarak tutarlı görünsünler diye tek yerde tanımlı.

  Cihaz ikonları sayfanın görsel kimliğinin ana kaynağı: fotoğraf yok, o yüzden
  her hizmetin kendi silüeti var. Tamamı birkaç yüz byte.
*/
import type { IkonAdi } from '@/lib/types';

interface Props {
  ad: IkonAdi;
  boyut?: number;
  class?: string;
}

const { ad, boyut = 24, class: sinif = '' } = Astro.props;

// Kontur tabanlı ikonlar
const konturlu: Partial<Record<IkonAdi, string>> = {
  klima: `<rect x="2.75" y="4.75" width="18.5" height="8.5" rx="2"/>
    <path d="M6 9.5h12"/>
    <path d="M7.5 17c.9-.9.9-2.1 0-3M12 18.5c.9-.9.9-2.1 0-3M16.5 17c.9-.9.9-2.1 0-3"/>`,
  camasir: `<rect x="3.75" y="2.75" width="16.5" height="18.5" rx="2"/>
    <path d="M3.75 7.25h16.5"/><circle cx="12" cy="14.25" r="4.25"/>
    <circle cx="12" cy="14.25" r="1.5"/><circle cx="7" cy="5" r=".9"/>`,
  bulasik: `<rect x="3.75" y="2.75" width="16.5" height="18.5" rx="2"/>
    <path d="M3.75 7.25h16.5"/><circle cx="12" cy="14.5" r="3.5"/>
    <path d="M12 11v3.5"/><circle cx="7" cy="5" r=".9"/>`,
  buzdolabi: `<rect x="5.25" y="2.75" width="13.5" height="18.5" rx="2"/>
    <path d="M5.25 9.5h13.5"/><path d="M8.25 5.5v2"/><path d="M8.25 12v3"/>`,
  kurutma: `<rect x="3.75" y="2.75" width="16.5" height="18.5" rx="2"/>
    <path d="M3.75 7.25h16.5"/><circle cx="12" cy="14.25" r="4.25"/>
    <path d="M9.9 14.25a2.1 2.1 0 0 1 4.2 0 2.1 2.1 0 0 0 4.2 0" transform="scale(.55) translate(9.8 11.6)"/>
    <circle cx="7" cy="5" r=".9"/>`,
  televizyon: `<rect x="2.75" y="4.25" width="18.5" height="12.5" rx="2"/>
    <path d="M12 16.75v3"/><path d="M8.25 19.75h7.5"/>`,
  // Duvar tipi kombi: gövde + gösterge + kumanda düğmesi + alttan çıkan üç
  // tesisat borusu. Alev çizilmedi — gaz devresine dokunmuyoruz (bkz. G3).
  kombi: `<rect x="4.75" y="3.25" width="14.5" height="12.5" rx="2"/>
    <path d="M7.75 7h4.5"/><circle cx="16" cy="7" r=".9"/>
    <path d="M7.75 11.25h8.5"/>
    <path d="M8.5 15.75v4M12 15.75v4M15.5 15.75v4"/>`,
  telefon: `<path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z" fill="currentColor" stroke="none"/>`,
  kalkan: `<path d="M12 2.75 4.75 5.5v5.75c0 4.6 3.1 8.6 7.25 9.9 4.15-1.3 7.25-5.3 7.25-9.9V5.5L12 2.75Z"/>
    <path d="m8.75 11.75 2.25 2.25 4.25-4.25"/>`,
  arama: `<circle cx="10.5" cy="10.5" r="6.25"/><path d="m15.25 15.25 4.5 4.5"/>`,
  kart: `<rect x="2.75" y="5.25" width="18.5" height="13.5" rx="2"/>
    <path d="M2.75 10h18.5"/><path d="M6.5 14.75h3.5"/>`,
  saat: `<circle cx="12" cy="12" r="9.25"/><path d="M12 6.75V12l3.5 2.25"/>`,
  konum: `<path d="M12 21.5s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/>
    <circle cx="12" cy="10.5" r="2.75"/>`,
  ok: `<path d="M4.75 12h14"/><path d="m13 6.25 5.75 5.75L13 17.75"/>`,
  chevron: `<path d="m6.25 9.5 5.75 5.75 5.75-5.75"/>`,
  'dis-link': `<path d="M14 3.75h6.25V10"/><path d="M20.25 3.75 11.5 12.5"/>
    <path d="M18 14v5.25a1 1 0 0 1-1 1H4.75a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1H10"/>`,
  onay: `<path d="m4.75 12.5 4.75 4.75 9.75-10"/>`,
  arac: `<path d="M14.7 6.3a4.5 4.5 0 0 0 5.9 5.9l-8.4 8.4a2.1 2.1 0 0 1-3-3l8.4-8.4Z" transform="translate(0 -1)"/>
    <path d="M6.5 3.5 3.5 6.5l3 3 2-1 1-2-3-3Z"/>`,
};

// Tek parça dolgu ikonu (WhatsApp kendi glifi)
const dolgulu: Partial<Record<IkonAdi, string>> = {
  whatsapp: `<path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.1 14c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6a11 11 0 0 1-4.2-3.8c-.3-.4-.9-1.4-.9-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.3.4c-.1.2-.3.3-.1.6a8 8 0 0 0 3.4 2.9c.3.2.5.1.6 0l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3 0 .1 0 .6-.2 1.2Z"/>`,
};

const dolgu = dolgulu[ad];
const icerik = dolgu ?? konturlu[ad] ?? '';
---

<svg
  width={boyut}
  height={boyut}
  viewBox="0 0 24 24"
  class={sinif}
  aria-hidden="true"
  focusable="false"
  fill={dolgu ? 'currentColor' : 'none'}
  stroke={dolgu ? 'none' : 'currentColor'}
  stroke-width={dolgu ? undefined : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icerik}
/>
