---
/*
  Tek "Ara" / "WhatsApp" çifti. Aynı eylem her yerde aynı adla anılır:
  "Hemen Ara" ve "WhatsApp'tan Yaz". Metinler burada değişir, her yer değişir.

  boyut="buyuk" ana CTA'yı basar: numaranın kendisi sayfadaki en büyük
  tipografik nesnedir. Bu sitenin tek başarı ölçütü telefon araması, dolayısıyla
  numara sayfanın en değerli pikselidir.

  Numara doldurulmamışsa (telLink/whatsappLink null döner) butonlar
  pointer-events-none ile pasifleşir — ölü linke tıklatmayız.
*/
import Ikon from './Ikon.astro';
import { firma, telLink, whatsappLink, deger } from '@/lib/veri';
import type { Konum } from '@/lib/analytics';

interface Props {
  konum: Konum;
  /** WhatsApp mesajına önceden yazılacak bağlam. */
  mesaj: string;
  boyut?: 'normal' | 'buyuk';
  /** Koyu blok üzerinde kullanılıyorsa renkler çevrilir. */
  zemin?: 'acik' | 'koyu';
  class?: string;
}

const { konum, mesaj, boyut = 'normal', zemin = 'acik', class: sinif = '' } = Astro.props;

const tel = telLink();
const wa = whatsappLink(mesaj);
const numara = deger(firma.telefon);
const koyu = zemin === 'koyu';

// Dokunma hedefi hiçbir yerde 48 px'in altına inmez (asgari kural 44).
// Köşe bilerek burada YOK: her varyant kendi köşesini verir. rounded-sm ile
// rounded-md aynı öğede olursa hangisinin kazanacağı CSS üretim sırasına kalır.
const temel =
  'inline-flex min-h-12 items-center justify-center gap-2 px-6 font-semibold transition-colors duration-150';
const kapali = 'pointer-events-none opacity-55';
---

{
  boyut === 'buyuk' ? (
    <div class={`flex flex-col gap-3 ${sinif}`}>
      <a
        href={tel ?? '#'}
        data-olay="tel_click"
        data-konum={konum}
        aria-disabled={tel ? undefined : 'true'}
        class:list={[
          'group flex items-center gap-4 rounded-lg px-5 py-4 transition-colors duration-150 sm:px-6 sm:py-5',
          'bg-turuncu-500 text-lacivert-900 shadow-cta hover:bg-turuncu-400',
          !tel && kapali,
        ]}
      >
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-sm bg-lacivert-900/10">
          <Ikon ad="telefon" boyut={26} />
        </span>
        {/* Numara sayfadaki en büyük tipografik nesne. Yoksa hiç basılmaz:
            iskele metni yazmaktansa buton sade "Hemen Ara" olarak kalır. */}
        <span class="min-w-0">
          {numara ? (
            <>
              <span class="etiket block opacity-80">Hemen Ara</span>
              <span class="rakam text-numara mt-1 block leading-none font-extrabold tracking-tight whitespace-nowrap">
                {numara}
              </span>
            </>
          ) : (
            <span class="text-h3 block leading-none font-extrabold">Hemen Ara</span>
          )}
        </span>
      </a>

      {/* WhatsApp ikincil kalır: Google Ads'te birincil dönüşüm form + uzun çağrı. */}
      <a
        href={wa ?? '#'}
        data-olay="whatsapp_click"
        data-konum={konum}
        rel="noopener"
        aria-disabled={wa ? undefined : 'true'}
        class:list={[
          temel,
          'rounded-lg py-3',
          koyu
            ? 'border-[1.5px] border-white/30 text-white hover:bg-white/10'
            : 'bg-yesil-600 text-white hover:bg-yesil-700',
          !wa && kapali,
        ]}
      >
        <Ikon ad="whatsapp" boyut={20} />
        WhatsApp'tan Yaz
      </a>
    </div>
  ) : (
    <div class={`flex flex-col gap-3 sm:flex-row ${sinif}`}>
      <a
        href={tel ?? '#'}
        data-olay="tel_click"
        data-konum={konum}
        aria-disabled={tel ? undefined : 'true'}
        class:list={[temel, 'rounded-sm bg-turuncu-500 font-bold text-lacivert-900 hover:bg-turuncu-400', !tel && kapali]}
      >
        <Ikon ad="telefon" boyut={20} />
        Hemen Ara
        {numara && <span class="rakam hidden sm:inline">{numara}</span>}
      </a>

      <a
        href={wa ?? '#'}
        data-olay="whatsapp_click"
        data-konum={konum}
        rel="noopener"
        aria-disabled={wa ? undefined : 'true'}
        class:list={[temel, 'rounded-sm bg-yesil-600 text-white hover:bg-yesil-700', !wa && kapali]}
      >
        <Ikon ad="whatsapp" boyut={20} />
        WhatsApp'tan Yaz
      </a>
    </div>
  )
}
