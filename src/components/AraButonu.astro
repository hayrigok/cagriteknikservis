---
// Tek bir "Ara" / "WhatsApp" buton çifti. Her yerde aynı eylem aynı adla anılır:
// "Hemen Ara" ve "WhatsApp'tan Yaz". Metinleri burada değiştirmek her yeri değiştirir.
import { firma, telLink, whatsappLink } from '@/lib/veri';
import type { Konum } from '@/lib/analytics';

interface Props {
  konum: Konum;
  /** WhatsApp mesajına önceden yazılacak bağlam. */
  mesaj: string;
  boyut?: 'normal' | 'buyuk';
  class?: string;
}

const { konum, mesaj, boyut = 'normal', class: sinif = '' } = Astro.props;

const tel = telLink();
const wa = whatsappLink(mesaj);

const olcu = boyut === 'buyuk' ? 'px-6 py-4 text-lg' : 'px-4 py-3 text-base';
const ortak = `inline-flex items-center justify-center gap-2 rounded-lg font-semibold text-white transition-colors ${olcu}`;
---

<div class={`flex flex-col gap-3 sm:flex-row ${sinif}`}>
  <a
    href={tel ?? '#'}
    data-olay="tel_click"
    data-konum={konum}
    aria-disabled={tel ? undefined : 'true'}
    class={`${ortak} bg-aksiyon-600 hover:bg-aksiyon-700 ${tel ? '' : 'pointer-events-none opacity-60'}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
      ></path>
    </svg>
    Hemen Ara{tel && <span class="sr-only">: {firma.telefon}</span>}
  </a>

  <a
    href={wa ?? '#'}
    data-olay="whatsapp_click"
    data-konum={konum}
    rel="noopener"
    aria-disabled={wa ? undefined : 'true'}
    class={`${ortak} bg-whatsapp-600 hover:bg-whatsapp-700 ${wa ? '' : 'pointer-events-none opacity-60'}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.1 14c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6a11 11 0 0 1-4.2-3.8c-.3-.4-.9-1.4-.9-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.3.4c-.1.2-.3.3-.1.6a8 8 0 0 0 3.4 2.9c.3.2.5.1.6 0l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3 0 .1 0 .6-.2 1.2Z"
      ></path>
    </svg>
    WhatsApp'tan Yaz
  </a>
</div>
