---
// Consent Mode'un ön koşulu. Onay verilmeden hiçbir ölçüm olayı gönderilmez.
// Pop-up değil: sayfayı örtmeyen, kapatılabilir alt bant. Giriş animasyonu yok.
---

<div
  data-cerez
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-marka-100 bg-white p-4 shadow-[0_-2px_10px_rgba(0,0,0,0.08)] md:bottom-0"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-metin-soluk">
      Hizmetimizi geliştirmek için ölçümleme çerezleri kullanmak istiyoruz.
      Onaylamazsanız site aynı şekilde çalışır.
      <a href="/kvkk/" class="underline">Ayrıntılar</a>
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        data-cerez-ret
        type="button"
        class="rounded-lg border border-marka-100 px-4 py-2.5 text-sm font-semibold text-metin"
      >
        Reddet
      </button>
      <button
        data-cerez-kabul
        type="button"
        class="rounded-lg bg-marka-600 px-4 py-2.5 text-sm font-semibold text-white"
      >
        Kabul et
      </button>
    </div>
  </div>
</div>

<script>
  import { onayDurumu, onayVer } from '@/lib/analytics';

  const bant = document.querySelector<HTMLElement>('[data-cerez]');
  if (bant) {
    // Karar verilmemişse göster. hidden ile başladığı için CLS yaratmaz.
    if (onayDurumu() === null) {
      bant.hidden = false;
      // Mobil alt çubuğun üstüne otursun
      bant.style.paddingBottom = 'calc(1rem + 3.5rem)';
      if (window.matchMedia('(min-width: 768px)').matches) bant.style.paddingBottom = '1rem';
    }

    bant.querySelector('[data-cerez-kabul]')?.addEventListener('click', () => {
      onayVer(true);
      bant.hidden = true;
    });
    bant.querySelector('[data-cerez-ret]')?.addEventListener('click', () => {
      onayVer(false);
      bant.hidden = true;
    });
  }
</script>
