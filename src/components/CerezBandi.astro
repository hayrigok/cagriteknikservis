---
// Consent Mode'un ön koşulu. Onay verilmeden hiçbir ölçüm olayı gönderilmez.
// Pop-up DEĞİL: sayfayı örtmeyen, kapatılabilir alt bant. Giriş animasyonu yok.
// hidden ile başlar, karar verilmemişse JS açar — bu yüzden CLS yaratmaz.
//
// Konum CSS ile: md altında bant, sabit alt çubuğun (MobilBar, 3.5rem +
// güvenli alan) ÜSTÜNDE durur; md'de çubuk gizli, bant en altta.
// 02.10.2026'ya kadar alttan beyaz dolgu veriliyordu ve bant z-50 olduğu için
// o dolgu "Hemen Ara" çubuğunu ÖRTÜYORDU. Ara çözümde konum JS'le bir kez
// hesaplandı; telefon çevrilince bayatlıyordu. Medya sorgusu her çevirmede
// kendiliğinden doğru kalır.
---

<div
  data-cerez
  hidden
  class="fixed inset-x-0 bottom-[calc(3.5rem+env(safe-area-inset-bottom))] z-50 border-t border-lacivert-100 bg-white py-3 shadow-[0_-8px_24px_-12px_rgb(10_31_68/0.25)] sm:py-4 md:bottom-0"
>
  <div class="kap flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p class="text-[13px] leading-snug text-metin-soluk sm:text-kucuk sm:leading-relaxed">
      Hizmetimizi geliştirmek için ölçümleme çerezleri kullanmak istiyoruz.
      Onaylamazsanız site aynı şekilde çalışır.
      <a href="/kvkk/" class="font-semibold text-kobalt-600 underline">Ayrıntılar</a>
    </p>
    <div class="grid shrink-0 grid-cols-2 gap-2 sm:flex">
      <button
        data-cerez-ret
        type="button"
        class="min-h-11 rounded-sm border-[1.5px] border-lacivert-400 px-5 text-kucuk font-semibold text-metin transition-colors duration-150 hover:bg-zemin"
      >
        Reddet
      </button>
      <button
        data-cerez-kabul
        type="button"
        class="min-h-11 rounded-sm bg-lacivert-900 px-5 text-kucuk font-semibold text-white transition-colors duration-150 hover:bg-lacivert-800"
      >
        Kabul et
      </button>
    </div>
  </div>
</div>

<script>
  import { onayDurumu, onayVer } from '@/lib/analytics';

  const bant = document.querySelector<HTMLElement>('[data-cerez]');
  if (bant) {
    if (onayDurumu() === null) {
      bant.hidden = false;
    }

    bant.querySelector('[data-cerez-kabul]')?.addEventListener('click', () => {
      onayVer(true);
      bant.hidden = true;
    });
    bant.querySelector('[data-cerez-ret]')?.addEventListener('click', () => {
      onayVer(false);
      bant.hidden = true;
    });
  }
</script>
