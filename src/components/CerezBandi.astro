---
// Consent Mode'un ön koşulu. Onay verilmeden hiçbir ölçüm olayı gönderilmez.
// Pop-up DEĞİL: sayfayı örtmeyen, kapatılabilir alt bant. Giriş animasyonu yok.
// hidden ile başlar, karar verilmemişse JS açar — bu yüzden CLS yaratmaz.
---

<div
  data-cerez
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t-2 border-lacivert-900 bg-white p-4 shadow-[0_-2px_16px_rgba(11,41,66,0.12)]"
>
  <div class="kap flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-kucuk leading-relaxed text-metin-soluk">
      Hizmetimizi geliştirmek için ölçümleme çerezleri kullanmak istiyoruz.
      Onaylamazsanız site aynı şekilde çalışır.
      <a href="/kvkk/" class="font-semibold text-lacivert-700 underline">Ayrıntılar</a>
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        data-cerez-ret
        type="button"
        class="min-h-11 rounded-sm border-2 border-lacivert-100 px-5 text-kucuk font-semibold text-metin transition-colors duration-150 hover:bg-zemin"
      >
        Reddet
      </button>
      <button
        data-cerez-kabul
        type="button"
        class="min-h-11 rounded-sm bg-lacivert-900 px-5 text-kucuk font-semibold text-white transition-colors duration-150 hover:bg-lacivert-800"
      >
        Kabul et
      </button>
    </div>
  </div>
</div>

<script>
  import { onayDurumu, onayVer } from '@/lib/analytics';

  const bant = document.querySelector<HTMLElement>('[data-cerez]');
  if (bant) {
    if (onayDurumu() === null) {
      bant.hidden = false;
      // Mobil sabit alt çubuğun üstüne otursun
      const genis = window.matchMedia('(min-width: 768px)').matches;
      bant.style.paddingBottom = genis ? '1rem' : 'calc(1rem + 3.5rem)';
    }

    bant.querySelector('[data-cerez-kabul]')?.addEventListener('click', () => {
      onayVer(true);
      bant.hidden = true;
    });
    bant.querySelector('[data-cerez-ret]')?.addEventListener('click', () => {
      onayVer(false);
      bant.hidden = true;
    });
  }
</script>
