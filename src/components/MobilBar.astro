---
/*
  14 — Mobil sabit alt çubuk: Ara | WhatsApp. Yalnızca mobilde, saf CSS.
  Arama tarafı bilerek geniş (3/5): sayfanın tek başarı ölçütü telefon araması,
  WhatsApp ikincil kanal.
*/
import Ikon from './Ikon.astro';
import { telLink, whatsappLink } from '@/lib/veri';

interface Props {
  waMesaji: string;
}

const { waMesaji } = Astro.props;
const tel = telLink();
const wa = whatsappLink(waMesaji);
---

<nav
  aria-label="Hızlı iletişim"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-black/10 bg-white pb-[env(safe-area-inset-bottom)] md:hidden"
>
  <a
    href={tel ?? '#'}
    data-olay="tel_click"
    data-konum="mobil_bar"
    aria-disabled={tel ? undefined : 'true'}
    class:list={[
      'col-span-3 flex h-14 items-center justify-center gap-2 bg-turuncu-600 text-[17px] font-bold text-white',
      !tel && 'pointer-events-none opacity-55',
    ]}
  >
    <Ikon ad="telefon" boyut={20} />
    Hemen Ara
  </a>

  <a
    href={wa ?? '#'}
    data-olay="whatsapp_click"
    data-konum="mobil_bar"
    rel="noopener"
    aria-disabled={wa ? undefined : 'true'}
    class:list={[
      'col-span-2 flex h-14 items-center justify-center gap-2 bg-yesil-600 text-[17px] font-bold text-white',
      !wa && 'pointer-events-none opacity-55',
    ]}
  >
    <Ikon ad="whatsapp" boyut={20} />
    WhatsApp
  </a>
</nav>
