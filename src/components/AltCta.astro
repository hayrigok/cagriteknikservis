---
// 13a — Alt CTA. Sayfanın koyu kapanışı; hero ile bilerek aynı renk ailesinde,
// böylece sayfa iki koyu blok arasında kapanıyor.
import AraButonu from './AraButonu.astro';
import Ikon from './Ikon.astro';
import { firma, doldurulmusMu } from '@/lib/veri';

interface Props {
  baslik: string;
  waMesaji: string;
}

const { baslik, waMesaji } = Astro.props;
---

<section class="koyu-blok isik relative overflow-hidden bg-lacivert-900">
  <div class="kap relative py-14 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="etiket text-turuncu-300">Arıza hattı</p>
        <p class="text-h2 mt-3 leading-[1.15] font-extrabold tracking-tight text-balance text-white">
          {baslik}
        </p>
        <p class="text-lead mt-4 max-w-xl leading-relaxed text-lacivert-200">
          Telefonda kısa bir tarif yeter, gerisini biz hallederiz.
        </p>

        {
          doldurulmusMu(firma.calismaSaatleri) && (
            <p class="mt-5 inline-flex items-center gap-2 text-kucuk text-lacivert-300">
              <Ikon ad="saat" boyut={16} class="text-turuncu-300" />
              {firma.calismaSaatleri}
            </p>
          )
        }
      </div>

      <AraButonu konum="footer" mesaj={waMesaji} boyut="buyuk" zemin="koyu" class="max-w-md" />
    </div>
  </div>
</section>
