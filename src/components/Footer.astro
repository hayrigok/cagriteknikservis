---
// 13b — Footer: ünvan, adres, vergi no, çalışma saatleri + site haritası.
// Reddi beyan "yetkili servis" ibaresini KULLANMADAN yazıldı, öyle kalsın:
// yazılı marka yetkisi olmadan o ibare haksız rekabet ve marka şikâyeti demek,
// bu da tüm Google Ads reklamlarının yayından kalkması demek.
//
// "Sitede anılan marka adları…" cümlesi 12.08.2026'da GERİ EKLENDİ. A6 kapanırken
// (29.07) sitede hiç marka adı geçmediği için o cümle yanlış kalmış ve
// kaldırılmıştı; sahibinin isteğiyle marka adları geri geldi, cümle de geri
// geldi. İKİSİ BİRLİKTE HAREKET EDER — marka adları sayfadan çıkarsa bu cümle de
// çıkar, marka adları eklenirse bu cümle şart.
//
// "Kullanım koşulları" bağlantısı — 01.10.2026, sahibinin isteği. "Aracı kurum"
// ve sorumluluk metni footer'da GÖRÜNMEZ, yalnızca o bağlantının arkasındaki
// sayfada durur. CLAUDE.md → E3.
//
// Şablona HTML yorumu (<!-- -->) YAZMAYIN: Astro onu her sayfanın kaynağına
// basıyor, iç notlar ziyaretçiye görünür. Notlar bu bloğa yazılır.
import Ikon from './Ikon.astro';
import { aktifHizmetler, firma, gecerliIlceler, tumIlceler, deger } from '@/lib/veri';

const hizmetler = aktifHizmetler();
const linkliIlceler = gecerliIlceler();
const tumAktifIlceler = tumIlceler().filter((i) => i.aktif);
const ilkHizmet = hizmetler[0];

// Doldurulmamış künye alanı basılmaz (bkz. veri.ts → deger()). Ziyaretçiye
// yarım künye göstermek, iskele metni göstermekten iyidir; eksikler build
// çıktısındaki [eksik-veri] raporunda listeleniyor.
const unvan = deger(firma.unvan);
const adres = deger(firma.adres);
const telefon = deger(firma.telefon);
const saatler = deger(firma.calismaSaatleri);
const vergiSatiri = [
  deger(firma.vergiDairesi) && `Vergi dairesi: ${deger(firma.vergiDairesi)}`,
  deger(firma.vergiNo) && `Vergi no: ${deger(firma.vergiNo)}`,
]
  .filter(Boolean)
  .join(' · ');
const kunyeVar = Boolean(adres || vergiSatiri || saatler);
---

<footer class="bg-lacivert-900 text-lacivert-200">
  <div class="kap grid gap-12 py-16 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <p class="flex items-center gap-2.5 text-white">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm bg-white/10 text-turuncu-300">
          <Ikon ad="arac" boyut={20} />
        </span>
        <span class="font-bold">{firma.kisaAd}</span>
      </p>

      {unvan && <p class="mt-5 font-semibold text-white">{unvan}</p>}

      {
        kunyeVar && (
          <address class="mt-2 space-y-1.5 text-kucuk leading-relaxed not-italic">
            {adres && <p>{adres}</p>}
            {vergiSatiri && <p>{vergiSatiri}</p>}
            {saatler && <p>Çalışma saatleri: {saatler}</p>}
          </address>
        )
      }

      {
        telefon && (
          <a
            href={`tel:${telefon.replace(/\s/g, '')}`}
            data-olay="tel_click"
            data-konum="footer"
            class="rakam mt-5 inline-flex min-h-11 items-center gap-2 text-h3 font-bold text-white transition-colors duration-150 hover:text-turuncu-300"
          >
            <Ikon ad="telefon" boyut={20} class="text-turuncu-300" />
            {telefon}
          </a>
        )
      }
    </div>

    <nav aria-label="Hizmetler" class="lg:col-span-4">
      <h2 class="etiket text-turuncu-300">Hizmetler</h2>
      <ul class="mt-4 grid gap-2 text-kucuk sm:grid-cols-2 lg:grid-cols-1">
        {
          hizmetler.map((h) => (
            <li>
              <a
                href={`/${h.slug}/`}
                class="transition-colors duration-150 hover:text-white hover:underline"
              >
                {h.ad}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-2">
      <h2 class="etiket text-turuncu-300">Bölgeler</h2>
      <ul class="mt-4 grid gap-2 text-kucuk">
        {
          linkliIlceler.length > 0 && ilkHizmet
            ? linkliIlceler.map((i) => (
                <li>
                  <a
                    href={`/${ilkHizmet.slug}/${i.slug}/`}
                    class="transition-colors duration-150 hover:text-white hover:underline"
                  >
                    {i.ad}
                  </a>
                </li>
              ))
            : tumAktifIlceler.map((i) => <li>{i.ad}</li>)
        }
      </ul>
    </div>

    <nav aria-label="Kurumsal" class="lg:col-span-2">
      <h2 class="etiket text-turuncu-300">Site</h2>
      <ul class="mt-4 grid gap-2 text-kucuk">
        <li>
          <a href="/blog/" class="transition-colors duration-150 hover:text-white hover:underline">
            Arıza rehberi
          </a>
        </li>
        <li>
          <a href="/iletisim/" class="transition-colors duration-150 hover:text-white hover:underline">
            İletişim
          </a>
        </li>
        <li>
          <a href="/kvkk/" class="transition-colors duration-150 hover:text-white hover:underline">
            KVKK
          </a>
        </li>
        <li>
          <a href="/kullanim-kosullari/" class="transition-colors duration-150 hover:text-white hover:underline">
            Kullanım koşulları
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <p class="kap py-6 text-etiket leading-relaxed text-lacivert-300">
      Bağımsız bir servis firmasıyız ve hiçbir üreticiyle bayilik veya temsilcilik
      ilişkimiz yoktur. Marka ayrımı yapmadan, klima ve beyaz eşyanın bütün
      markalarında tamir ve bakım hizmeti veriyoruz. Sitede anılan marka adları
      yalnızca hangi ürünlerde hizmet verdiğimizi belirtmek için kullanılmıştır
      ve ilgili sahiplerine aittir.
    </p>
  </div>
</footer>
