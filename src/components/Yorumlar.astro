---
// 10 — Yorumlar.
// Sahte yorum/yıldız/sayaç yazılmıyor ve AggregateRating şeması GÖMÜLMÜYOR.
// Yorumlar Google işletme profilinde, doğrulanabilir yerde duruyor.
import { firma, doldurulmusMu } from '@/lib/veri';

const url = firma.googleIsletmeUrl;
const hazir = doldurulmusMu(url);
---

<section class="mx-auto max-w-5xl px-4 py-10">
  <h2 class="text-2xl font-bold text-marka-900">Müşteri yorumları</h2>
  <p class="mt-3 max-w-2xl text-metin-soluk">
    Yorumlarımızı kendi sitemize kopyalamıyoruz. Hepsi Google işletme profilimizde,
    tarih ve isimleriyle birlikte duruyor.
  </p>

  {
    hazir ? (
      <a
        href={url}
        rel="noopener nofollow"
        target="_blank"
        class="mt-5 inline-flex items-center gap-2 rounded-lg border-2 border-marka-600 px-5 py-3 font-semibold text-marka-700 hover:bg-marka-50"
      >
        Google yorumlarımızı okuyun
        <span class="sr-only">(yeni sekmede açılır)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 3v2h3.6l-8.3 8.3 1.4 1.4L19 6.4V10h2V3h-7ZM5 5h5V3H3v18h18v-7h-2v5H5V5Z" />
        </svg>
      </a>
    ) : (
      <p class="mt-5 rounded-lg border border-dashed border-marka-100 bg-marka-50 p-4 text-sm text-metin-soluk">
        {'{PLACEHOLDER — Google işletme profili URL. firma.json içindeki googleIsletmeUrl doldurulunca buraya buton gelecek.}'}
      </p>
    )
  }
</section>
