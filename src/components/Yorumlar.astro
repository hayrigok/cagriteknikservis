---
/*
  10 — Yorumlar.
  SAHTE yorum/yıldız/sayaç yazılmıyor ve AggregateRating şeması GÖMÜLMÜYOR.
  Google kendi sitesine gömülen yerel işletme puanlarını zaten göstermiyor;
  uydurma puan ise doğrudan ceza riski. Yorumlar doğrulanabilir yerde, Google
  işletme profilinde duruyor ve oraya link veriyoruz.

  Profil URL'i yoksa BLOĞUN TAMAMI basılmaz. Alternatifi uydurma yorum yazmak
  olurdu; "yorumlarımız var ama gösteremiyoruz" diyen boş bir bölüm ise
  sayfayı yarım gösterir. Boş bölüm > sahte içerik, ama yok > boş bölüm.
*/
import Bolum from './Bolum.astro';
import Ikon from './Ikon.astro';
import { firma, deger } from '@/lib/veri';

const url = deger(firma.googleIsletmeUrl);
---

{
  url && (
    <Bolum
      etiket="Yorumlar"
      baslik="Müşteri yorumları"
      aciklama="Yorumlarımızı kendi sitemize kopyalamıyoruz. Hepsi Google işletme profilimizde, tarih ve isimleriyle birlikte duruyor."
    >
      <a
        href={url}
        rel="noopener nofollow"
        target="_blank"
        class="inline-flex min-h-12 items-center gap-2 rounded-sm border-2 border-lacivert-900 px-6 font-semibold text-lacivert-900 transition-colors duration-150 hover:bg-lacivert-900 hover:text-white"
      >
        Google yorumlarımızı okuyun
        <span class="sr-only">(yeni sekmede açılır)</span>
        <Ikon ad="dis-link" boyut={18} />
      </a>
    </Bolum>
  )
}
