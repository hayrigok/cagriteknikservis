---
import '@/styles/global.css';
import CerezBandi from '@/components/CerezBandi.astro';

interface Props {
  title: string;
  description: string;
  /** Sayfanın kendi yolu, canonical bundan kurulur. */
  yol: string;
  /** Sayfaya gömülecek JSON-LD nesneleri. */
  schema?: unknown[];
  /** Ölçümlemede form_start/form_submit ile gönderilecek sayfa kimliği. */
  sayfaKimligi: string;
}

const { title, description, yol, schema = [], sayfaKimligi } = Astro.props;
const canonical = new URL(yol, Astro.site).href;
const gecerliSchema = schema.filter((s) => s !== null && s !== undefined);
---

<!doctype html>
<html lang="tr" data-sayfa={sayfaKimligi}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />

    {
      gecerliSchema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >İçeriğe geç</a
    >

    <slot />

    <CerezBandi />

    <script>
      import { baglat } from '@/lib/analytics';
      const kimlik = document.documentElement.dataset.sayfa ?? 'bilinmiyor';
      baglat(kimlik);
    </script>
  </body>
</html>
