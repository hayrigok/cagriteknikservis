---
/*
  Tüm sayfaların kabuğu: head, canonical, JSON-LD, atlama linki, çerez bandı ve
  ölçüm katmanının başlatılması.

  JSON-LD dizisi sayfadan gelir; null üyeler (örn. dolu cevabı olmayan FAQPage)
  elenir — boş şema basmayız.
*/
import '@/styles/global.css';
import CerezBandi from '@/components/CerezBandi.astro';
import { firma, olcumKimlikleri } from '@/lib/veri';

interface Props {
  title: string;
  description: string;
  /** Kök göreli yol, sonda / ile. Canonical bundan kurulur. */
  yol: string;
  schema?: (Record<string, unknown> | null)[];
  /** Ölçüm olaylarında "sayfa" parametresi olarak gider. */
  sayfaKimligi: string;
  /** 404 gibi arama sonucunda görünmemesi gereken sayfalar. */
  dizinlenmesin?: boolean;
}

const { title, description, yol, schema = [], sayfaKimligi, dizinlenmesin = false } = Astro.props;

const canonical = new URL(yol, Astro.site).href;
const semalar = schema.filter((s): s is Record<string, unknown> => s !== null);

/*
  Paylaşım görseli. Sayfa hızına etkisi YOK: bu dosyayı tarayıcı değil yalnızca
  WhatsApp/Facebook/X'in önizleme robotları indirir. Görselsiz paylaşılan link
  sohbette çıplak bir bağlantı olarak görünüyordu; form akışı WhatsApp'a gittiği
  için bu doğrudan görünürlük kaybıydı. tools/og-uret.mjs ile üretiliyor.
*/
const ogGorsel = new URL('/og.png', Astro.site).href;

/*
  Ölçüm kimlikleri istemciye <html> nitelikleriyle taşınıyor, import ile DEĞİL:
  analytics.ts istemci paketine giriyor ve oradan `@/lib/veri` import etmek
  ilceler.json + hizmetler.json'ın tamamını tarayıcıya indirirdi.

  Kimlik doldurulmamışsa VEYA biçimi bozuksa nitelik hiç basılmaz; analytics.ts
  de o zaman googletagmanager.com'a hiçbir istek yapmaz. Yani şu an dış istek
  SIFIR. Biçim denetimi veri.ts → olcumKimlikleri() içinde, gerekçesi orada.
*/
const { ga: gaKimlik, ads: adsKimlik } = olcumKimlikleri();
---

<!doctype html>
<html lang="tr" data-sayfa={sayfaKimligi} data-ga={gaKimlik} data-ads={adsKimlik}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /*
        Hata sayfası kendine canonical verirse Google için o adres "geçerli bir
        sayfa" olur ve soft-404 sinyali doğar. noindex varken canonical hiç
        basılmaz; follow açık kalır ki içindeki hizmet linkleri taranabilsin.
      */
      dizinlenmesin ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={firma.kisaAd} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${firma.kisaAd} — ${firma.telefon}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0b2942" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      semalar.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>

  <body class="font-sans antialiased">
    {/*
      Hedefi her sayfadaki <main id="icerik">. main SAYFALARDA, burada değil:
      slot'un tamamını sarsaydık <header> (StickyUstCubuk), <footer> ve
      <nav> (MobilBar) main'in İÇİNDE kalırdı — tek uyarıyı üçe çıkarırdı.
      Sayfa iskeleti bu yüzden StickyUstCubuk → main → Footer sırasında.
    */}
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-lacivert-900 focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      İçeriğe atla
    </a>

    <slot />

    <CerezBandi />

    <script>
      // Sayfa kimliği <html data-sayfa> üzerinden okunuyor — ayrı bir inline
      // script ile değişken taşımaya gerek yok, JS bütçesi böyle korunuyor.
      import { baglat } from '@/lib/analytics';
      baglat(document.documentElement.dataset.sayfa ?? 'bilinmiyor');
    </script>
  </body>
</html>
