# llms.txt Türkçe karakter taşıyor. Cloudflare .txt dosyasını charset'siz
# "text/plain" olarak sunuyordu; Chrome "eşya"yı "eÅŸya" diye gösterdi
# (01.10.2026'da ölçüldü). robots.txt ASCII, sitemap.xml kendi kodlamasını
# bildiriyor — yalnızca bu dosya gerekiyor.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Yazı tipi dosyalarının adı sürüm taşımıyor ama içerikleri değişmiyor.
# Bir gün değiştirilirse DOSYA ADI da değiştirilir (önbellek bir yıl).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
